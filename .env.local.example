# Frontend environment — copy to .env.local

# URL of the FastAPI backend. Leave unset/empty to run the frontend
# entirely on built-in mock data (current demo behaviour).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Dev only: an always-signed-in admin so every page is reachable without
# logging in. Never set this to true in production.
NEXT_PUBLIC_DEV_BYPASS_AUTH=false

# Public site URL, used for the sitemap, robots.txt and link-preview metadata.
# NEXT_PUBLIC_SITE_URL=https://autopilotv2.vercel.app

# Keep false until Stripe checkout is integrated: the paywall then says payments
# open soon and collects no card details.
# NEXT_PUBLIC_PAYMENTS_LIVE=false

# Error reporting (optional). Browser DSN; the server falls back to it when
# SENTRY_DSN is unset. Source maps upload only when SENTRY_AUTH_TOKEN,
# SENTRY_ORG and SENTRY_PROJECT are all set (Vercel build environment).
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_DSN=
