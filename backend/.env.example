# Backend configuration — copy to .env and fill in real values as services are connected.

# --- Core ---
ENVIRONMENT=development
API_PREFIX=/api
CORS_ORIGINS=http://localhost:3000
# Demo data is OFF by default (launch = real data only). Set true locally to
# explore the demo-only features (agents, arbitrage, portals…) with mock data —
# they share one in-memory store across everyone. Never set on production.
# SEED_DEMO_DATA=false

# --- Auth ---
# Signs session tokens. Production refuses to start unless this is a random
# value of 32+ characters. Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Comma-separated emails of platform owners — they can open the credential
# vault, all users, the audit log and demo reset.
# OWNER_EMAILS=you@yourcompany.com
# Email matching alone never grants owner access. After independently checking
# the person's identity/email and creating the account, provision it with:
# python -m app.owner_access you@yourcompany.com --grant --identity-checked
# This CLI requires MongoDB; see docs/finance-sandbox.md.

# --- Security hardening ---
# When set, all POST/PATCH/DELETE requests must send header: X-API-Key: <value>
# Generate one: py -c "import secrets; print(secrets.token_urlsafe(32))"
# API_KEY=

# --- Database — MongoDB Atlas ---
# Full state + user accounts persist here when set. Without it the app runs in-memory.
# MONGODB_URI=mongodb+srv://<user>:<password>@autopilot.<cluster>.mongodb.net
# MONGODB_DB=autopilot
# DATABASE_URL=postgresql://user:pass@localhost:5432/autopilot
# REDIS_URL=redis://localhost:6379/0
# INBOUND_EMAIL_DOMAIN=in.example.com
# INBOUND_EMAIL_WEBHOOK_SECRET=<random long secret>
# INBOUND_EMAIL_PLATFORMS=Fiverr,Upwork,Freelancer.com  # enable only after manual email-content and permission review
# OUTLOOK_INBOX_READ_APPROVED=false                 # enable only after Mail.Read consent + privacy review
# NANGO_SECRET_KEY=                  # server-side; never expose to the browser
# NANGO_BASE_URL=https://api.nango.dev
# NANGO_INTEGRATIONS=microsoft-outlook  # enable only provider configs with approved OAuth scopes
# COMPOSIO_API_KEY=                  # server-side project key; agent tools only
# COMPOSIO_ALLOWED_TOOLKITS=         # explicit comma-separated allowlist; empty disables all
# ACTIVEPIECES_WEBHOOK_URL=          # URL for an Activepieces webhook-trigger flow
# ACTIVEPIECES_WEBHOOK_SECRET=       # optional shared Bearer secret configured in that flow
# CHROMADB_URL=http://localhost:8001

# --- LLMs — Groq (free tier works) ---
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=openai/gpt-oss-120b
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# --- Payments ---
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_CONNECT_CLIENT_ID=

# --- Email (FREE tier — pick ONE option) ---
# Option A: Resend API — resend.com, 3,000 emails/mo free.
#   Until you verify a domain, it can only send to YOUR OWN email address;
#   verify a domain in Resend to email real users. Then set RESEND_FROM
#   like: "Autopilot <hello@yourbrand.com>"
# RESEND_API_KEY=re_...
# RESEND_FROM=Autopilot <onboarding@resend.dev>
#
# Option B: any free SMTP — Brevo (300/day), MailerSend (3,000/mo),
#   or a Gmail "App Password" (myaccount.google.com/apppasswords).
#   For Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USER=you@gmail.com
#   SMTP_PASSWORD=<16-char app password>
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=               # optional, defaults to SMTP_USER

# --- Communications ---
# ROCKETCHAT_URL=
# ROCKETCHAT_TOKEN=
# WHATSAPP_TOKEN=
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=

# --- Voice ---
# VAPI_API_KEY=

# --- Scraping infra ---
# SCRAPOXY_URL=
# PROXY_USERNAME=
# PROXY_PASSWORD=

# --- Platform connectors (official APIs) ---
# FREELANCER_OAUTH_TOKEN=           # Freelancer.com developer OAuth token
# FREELANCER_SANDBOX=false          # true = sandbox host; false = live freelancer.com
# UPWORK_PROPOSAL_SUBMIT_APPROVED=false # true only after written approval includes Submit Proposal
# UPWORK_MESSAGE_READ_APPROVED=false    # true only after approved messaging read scope
# UPWORK_MESSAGE_SEND_APPROVED=false    # true only after approved messaging write scope
# REDDIT_ACCESS_TOKEN=                 # Reddit Data API OAuth token
# REDDIT_COMMERCIAL_APPROVED=false     # enable only after Reddit commercial approval
# HN_COMMERCIAL_REUSE_APPROVED=false   # enable only after commercial reuse review

# --- Job Radar sources (backend/app/job_sources.py; terms in docs/platform-matrix.md) ---
# Public feeds whose operators publish them for reuse run by default.
# JOB_SOURCES_APPROVED=             # source ids to enable once their reuse review is recorded,
#                                   # e.g. rmt,hn,tc or company-board providers gh,lev,ash,smr,wkb,rct
# JOB_SOURCES_DISABLED=             # source ids to switch off, including default-on feeds
# Keyed job-search APIs — each source stays off until its credentials are set.
# THE_MUSE_API_KEY=
# USAJOBS_API_KEY=
# USAJOBS_USER_AGENT=               # the email address registered with the USAJOBS key
# JOOBLE_API_KEY=                   # free keys allow 500 requests in total
# WEB3_CAREER_TOKEN=
# ADZUNA_APP_ID=                    # also needs "adz" in JOB_SOURCES_APPROVED (commercial licence)
# ADZUNA_APP_KEY=
# ADZUNA_COUNTRY=us
# REED_API_KEY=                     # also needs "reed" in JOB_SOURCES_APPROVED (written permission)
# FINDWORK_API_TOKEN=               # also needs "fw" in JOB_SOURCES_APPROVED (rights review)

# --- Automation Worker (browser automation — separate Render service) ---
# WORKER_URL=https://autopilot-worker.onrender.com
# WORKER_KEY=                       # shared secret sent as X-Worker-Key to the worker

# --- Integrations ---
# N8N_WEBHOOK_URL=
# GITHUB_TOKEN=
# CALCOM_API_KEY=
# ODOO_URL=
